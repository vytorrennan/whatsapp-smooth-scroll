{
  "manifest_version": 3,
  "name": "WhatsApp Smooth Scroll",
  "version": "1.0.0",
  "description": "Reduce scrolling stutter in WhatsApp Web message history while keeping hardware acceleration enabled.",
  "permissions": ["storage"],
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"},
  "action": {"default_title": "WhatsApp Smooth Scroll", "default_popup": "popup.html"},
  "content_scripts": [{
    "matches": ["https://web.whatsapp.com/*"],
    "css": ["scrolling.css"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
